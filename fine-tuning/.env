# ===================== 1. 任务名称 =====================
TASK_NAME=法律知识微调训练-2

# ===================== 2. 基础模型 =====================
# 向量模型（微调底座，用于 embedding 检索）
VECTOR_MODEL=../models/system/bge-large-zh-v1.5
# 重排模型（用于检索后重排序；微调向量模型阶段不参与，仅记录路径）
RERANKER_MODEL=../rerankers/bge-reranker-base

# ===================== 3. 训练方法 =====================
# efficient=高效训练 / full=全参训练（实际均为全参数对比学习微调）
TRAIN_MODE=efficient

# ===================== 4. 数据配置 =====================
# 训练集
TRAIN_DATA=../data/datasets/法律数据集200000.jsonl
# 验证集比例（从训练集切分，0~1）
VALID_RATIO=0.1
# 测试集（留空则跳过评测）
TEST_DATA=../data/datasets/法律测试集20000.jsonl

# ===================== 5. 超参配置 =====================
NUM_EPOCHS=2
BATCH_SIZE=128
LR=2e-5
TEMPERATURE=0.05
WARMUP_RATIO=0.1
WEIGHT_DECAY=0.01
QUERY_MAX_LEN=128
PASSAGE_MAX_LEN=512
ADD_INSTRUCTION=true
INSTRUCTION=为这个句子生成表示以用于检索相关文章：
EVAL_STEPS=1000
SAVE_STEPS=1000

# ===================== 6. 保存模型名 =====================
OUTPUT_NAME=bge-legal-v1.0

# ===================== 7. 其它 =====================
# 评测采样条数（0=跳过，-1=全量）
EVAL_SAMPLES=2000
VAL_EVAL_SAMPLES=2000
# 随机种子
SEED=42