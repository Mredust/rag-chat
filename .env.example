# ==================== 应用 ====================
APP_NAME=rag-chat
LOG_LEVEL=INFO
LOG_FORMAT=text

# ==================== 数据库（MySQL）====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=ragchat

# ==================== 向量数据库（Chroma）====================
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_chunks

# 计算设备：cpu / cuda / cuda:0 / auto（auto 时按 CUDA 是否可用自动选择）
# 注意：代码默认值是 cpu，此行建议保留为 auto，否则 GPU 训练/向量化会静默跑在 CPU 上
EMBEDDING_DEVICE=auto

# ==================== 认证（JWT）====================
JWT_SECRET=rag-chat-dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== CORS ====================
CORS_ORIGINS=*