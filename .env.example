# ==================== 应用 ====================
APP_NAME=rag-chat
DEBUG=true
# 日志级别：DEBUG / INFO / WARNING / ERROR（DEBUG 会输出更细粒度的调用/切片/工具日志）
LOG_LEVEL=INFO
# 日志格式：text（纯文本，默认）/ json（结构化）
LOG_FORMAT=text

# ==================== 数据库（MySQL）====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=ragchat

# ==================== 向量数据库（Chroma）====================
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_chunks

# ==================== 大模型（LLM，OpenAI 兼容）====================
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro

# ==================== Embedding（OpenAI 兼容）====================
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-large-zh-v1.5
EMBEDDING_DIM=1024

# ==================== 认证（JWT）====================
JWT_SECRET=rag-chat-dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== CORS ====================
CORS_ORIGINS=*